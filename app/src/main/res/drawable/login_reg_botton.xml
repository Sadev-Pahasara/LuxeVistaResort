<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gradient Stroke -->
    <item>
        <shape>
            <corners android:radius="20dp"/>
            <gradient
                android:startColor="#116F00"
                android:endColor="#00EAFF"
                android:angle="0"/>
        </shape>
    </item>

    <!-- Your Original Shape -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">

        <shape>
            <corners android:radius="19dp"/>

            <gradient
                android:startColor="#00EAFF"
                android:endColor="#116F00"
                android:angle="0" />

        </shape>

    </item>

</layer-list>