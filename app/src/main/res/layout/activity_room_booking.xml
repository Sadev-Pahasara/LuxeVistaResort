<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:id="@+id/bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/login_bg"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Scrollable Screen -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBooking"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgHeader"
                android:layout_width="168dp"
                android:layout_height="196dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_black" />

            <!-- Glass panel -->
            <LinearLayout
                android:id="@+id/panelBooking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/glass"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Rooms -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose Your Room"
                    android:textColor="@color/b1"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Scrollable Rooms list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRooms"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="true"
                    android:overScrollMode="never" />

                <!-- Add-ons -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add-on Services"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/b1"
                    android:layout_marginTop="14dp"/>

                <!-- Scrollable Add-ons list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAddons"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="true"
                    android:overScrollMode="never"/>

                <!-- Booking Dates -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Booking Dates"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/b1"
                    android:layout_marginTop="14dp"/>

                <TextView
                    android:id="@+id/tvCheckIn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Select check-in date"
                    android:textColor="@color/g1"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvCheckOut"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Select check-out date"
                    android:textColor="@color/g1"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- BOOK BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBook"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="20dp"
                    android:text="BOOK"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:backgroundTint="#1DBD1D"
                    app:cornerRadius="12dp"
                    app:rippleColor="#66FFFFFF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>