<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mainbg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAdmin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome2"
                    android:fontFamily="@font/insans"
                    android:textStyle="bold"
                    android:textSize="35sp"
                    android:textColor="#0F172A"
                    android:layout_marginTop="80dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tvAdminName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adminname"
                    android:textSize="16sp"
                    android:textColor="#111827"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvWelcome"/>

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:src="@drawable/logo_black"
                    android:contentDescription="@string/logo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="215dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="215dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#A7F3D0"
                    app:cardBackgroundColor="#D7FECF">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="650px"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/availableroom"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#0F172A"
                            android:layout_gravity="center"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="215dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#A7F3D0"
                    app:cardBackgroundColor="#D7FECF">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="650px"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pnb"
                            android:gravity="center"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="#0F172A"
                            android:layout_gravity="center"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="10dp"/>

            <TextView
                android:id="@+id/tvQuickActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quick"
                android:textStyle="bold"
                android:textSize="26sp"
                android:textColor="#0F172A"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="40dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageBookings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/manage"
                android:textSize="18sp"
                android:fontFamily="@font/insans"
                android:letterSpacing="0.05"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/login_reg_botton"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                app:cornerRadius="18dp"
                android:layout_marginBottom="10dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageRooms"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="@string/managerooms"
                android:textSize="18sp"
                android:fontFamily="@font/insans"
                android:letterSpacing="0.05"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/login_reg_botton"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                app:cornerRadius="18dp"
                android:layout_marginBottom="10dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageServices"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="@string/manageservices"
                android:textSize="18sp"
                android:fontFamily="@font/insans"
                android:letterSpacing="0.05"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/login_reg_botton"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:layout_marginBottom="10dp"
                app:cornerRadius="18dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOffers"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="Offers"
                android:textSize="18sp"
                android:fontFamily="@font/insans"
                android:letterSpacing="0.05"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/login_reg_botton"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                app:cornerRadius="18dp"
                android:layout_marginBottom="10dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEvent"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="Event"
                android:textSize="18sp"
                android:fontFamily="@font/insans"
                android:letterSpacing="0.05"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/login_reg_botton"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                app:cornerRadius="18dp"
                app:elevation="0dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>