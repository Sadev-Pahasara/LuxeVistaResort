<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mainbg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollServicesAdmin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:padding="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Page Title -->
            <TextView
                android:id="@+id/tvServiceMgmtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVICES"
                android:textStyle="bold"
                android:fontFamily="@font/sansa"
                android:textSize="28sp"
                android:textColor="#0F172A"
                android:layout_marginTop="30dp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"/>

            <!-- Main rounded panel -->
            <LinearLayout
                android:id="@+id/panelServiceMgmt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_grey"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:padding="12dp">

                <!-- Available Services -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available Services"
                    android:textStyle="bold"
                    android:fontFamily="@font/insans"
                    android:textSize="20sp"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="10dp"/>

                <!-- List (RecyclerView) -->
                <!-- IMPORTANT:
                     - height should be wrap_content so it grows with content inside NestedScrollView
                     - nestedScrollingEnabled must be false to avoid scroll conflicts
                     - use layoutAnimation if you want later
                -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAdminServices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"/>

                <!-- Divider space -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp"/>

                <!-- Add New Service -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New Service"
                    android:textStyle="bold"
                    android:fontFamily="@font/insans"
                    android:textSize="20sp"
                    android:textColor="#0F172A"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"/>

                <!-- Image -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Image"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="6dp"/>

                <FrameLayout
                    android:id="@+id/boxServiceImage"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_input_grey"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to upload image"
                        android:textSize="12sp"
                        android:textColor="#475569"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <!-- ✅ NEW: Service Name (required for DB: a_name) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service Name"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etServiceName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_grey"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="@string/SnW"
                    android:textColor="#0F172A"
                    android:textColorHint="#64748B"
                    android:inputType="textCapWords"/>

                <!-- Service Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service Description"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etServiceDescription"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_grey"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="Enter description"
                    android:textColor="#0F172A"
                    android:textColorHint="#64748B"
                    android:inputType="textMultiLine"/>

                <!-- Service Key Features -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service Key Features"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etServiceFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_grey"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="Eg: Duration, Items included, Rules"
                    android:textColor="#0F172A"
                    android:textColorHint="#64748B"
                    android:inputType="textMultiLine"/>

                <!-- Service Price -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Service Price"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etServicePrice"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_grey"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="Eg: 2500"
                    android:textColor="#0F172A"
                    android:textColorHint="#64748B"
                    android:inputType="numberDecimal"/>

                <!-- Add Service button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddService"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="Add Service"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#0F172A"
                    app:backgroundTint="#42D11A"
                    app:cornerRadius="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>