<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mainbg">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvRoomTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/standRoom"
                android:textStyle="bold"
                android:fontFamily="@font/sansa"
                android:textSize="28sp"
                android:textColor="#111827"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_glass_panel">

                    <ImageView
                        android:id="@+id/imgRoomDetail"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/room1"
                        android:contentDescription="@null"/>

                    <TextView
                        android:id="@+id/tvRoomDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/desc"
                        android:textSize="14sp"
                        android:textColor="#374151"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/key"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#111827"
                        android:layout_marginTop="12dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvKeyFeatures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:id="@+id/tvRoomPriceDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/usdp"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#111827"
                        android:layout_marginTop="12dp"
                        android:layout_gravity="end"/>

                    <!-- ✅ Edit Room -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditRoom"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="@string/edit"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#22C55E"
                        android:textColor="@android:color/white"
                        android:layout_marginTop="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                    <!-- ✅ Toggle Availability -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleAvailability"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="@string/toggle"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#0EA5E9"
                        android:textColor="@android:color/white"
                        android:layout_marginTop="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                    <!-- ✅ Delete Room -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeleteRoom"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="@string/delete"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#EF4444"
                        android:textColor="@android:color/white"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>