<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mainbg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollRoomsAdmin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:padding="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Page Title -->
            <TextView
                android:id="@+id/tvRoomMgmtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROOM MANAGEMENT"
                android:textStyle="bold"
                android:fontFamily="@font/sansa"
                android:textSize="28sp"
                android:textColor="#0F172A"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="10dp"/>

            <!-- Main panel -->
            <LinearLayout
                android:id="@+id/panelRoomMgmt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_grey"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Available Rooms -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available Rooms"
                    android:textStyle="bold"
                    android:fontFamily="@font/insans"
                    android:textSize="20sp"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="10dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAdminRoomsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="true"/>

                <!-- ADD NEW ROOM -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADD NEW ROOM"
                    android:textStyle="bold"
                    android:fontFamily="@font/insans"
                    android:textSize="20sp"
                    android:textColor="#0F172A"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="10dp"/>

                <!-- Room Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room Name"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etRoomName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_grey"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="Enter room name"
                    android:textColor="#0F172A"
                    android:textColorHint="#64748B"
                    android:inputType="textCapWords"/>

                <!-- Room Image -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room Image"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="6dp"/>

                <FrameLayout
                    android:id="@+id/boxRoomImage"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_input_grey"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to upload image"
                        android:textSize="12sp"
                        android:textColor="#475569"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <!-- Room Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room Description"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etRoomDescription"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_grey"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="Enter description"
                    android:textColor="#0F172A"
                    android:textColorHint="#64748B"
                    android:inputType="textMultiLine"/>

                <!-- Room Key Features -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room Key Features"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etRoomFeatures"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_grey"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="Eg: Ocean view, King bed, Balcony"
                    android:textColor="#0F172A"
                    android:textColorHint="#64748B"
                    android:inputType="textMultiLine"/>

                <!-- Room Price -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room Price"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#0F172A"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/etRoomPrice"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_grey"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="Eg: 120"
                    android:textColor="#0F172A"
                    android:textColorHint="#64748B"
                    android:inputType="numberDecimal"/>

                <!-- Add Room Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddRoom"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Add Room"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#0F172A"
                    app:backgroundTint="#42D11A"
                    app:cornerRadius="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>